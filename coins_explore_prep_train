 num_cols, 4.8 * num_rows))\n","\n","    for plot_i, idx in enumerate(indices):\n","        img_tensor, y_true = dataset[idx]\n","\n","        x = img_tensor.unsqueeze(0).to(device)\n","        logits = model(x)\n","        probs = torch.sigmoid(logits).squeeze(0).cpu().numpy()\n","\n","        y_true = y_true.numpy()\n","\n","        true_labels = [motif_cols[j] for j, v in enumerate(y_true) if v == 1]\n","\n","        top_idxs = np.argsort(probs)[::-1][:top_k]\n","        top_preds = [f\"{motif_cols[j]}:{probs[j]:.2f}\" for j in top_idxs]\n","\n","        img = img_tensor.detach().cpu().permute(1, 2, 0).numpy()\n","\n","        mean = np.array([0.485, 0.456, 0.406])\n","        std = np.array([0.229, 0.224, 0.225])\n","        img = img * std + mean\n","        img = np.clip(img, 0, 1)\n","\n","        plt.subplot(num_rows, num_cols, plot_i + 1)\n","        plt.imshow(img)\n","        plt.axis(\"off\")\n","        plt.title(\n","            \"True: \" + (\", \".join(true_labels) if true_labels else \"none\") +\n","            \"\\nTop: \" + \", \".join(top_preds),\n","            fontsize=9,\n","        )\n","\n","    # plt.tight_layout()\n","    plt.show()"],"metadata":{"id":"F_BfaVHQ4Ha7"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["show_top_predictions(\n","    model=model,\n","    dataset=test_ds,\n","    motif_cols=sample_motifs,\n","    device=device,\n","    n=20,\n","    top_k=3,\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"1O-cYU_UVgEhBGRaSFQ9bJV4xMtJWqfQy"},"id":"QRJDEzz84Jgv","executionInfo":{"status":"ok","timestamp":1782337959069,"user_tz":420,"elapsed":2726,"user":{"displayName":"Elliot Cheung","userId":"18127261268990451389"}},"outputId":"2c895857-6d53-475c-9276-7110eaae5931"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":"Output hidden; open in https://colab.research.google.com to view."},"metadata":{}}]},{"cell_type":"mar